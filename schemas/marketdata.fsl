// FIG Schema Language — Market Data Schema
// Merged by `cargo xtask codegen` with orders.fsl (well-known id 0x01).

schema trading.orders v1.0.0 {
    description: "Public market data messages (§17.3)"
    well_known_id: 0x01

    type ClientOrderId: string(max_len: 20, pattern: "[A-Za-z0-9\\-]+")
    type Price: decimal64(precision: 8, min: 0)
    type Quantity: decimal64(precision: 0, min: 0, max: 999999999)
    type Symbol: string(max_len: 32, uppercase: true)
    type TradeTimestamp: int64

    message MarketDataSnapshot {
        channel_type: stream_item

        symbol: Symbol @1
        exchange: string(max_len: 16) @2
        bids: list<PriceLevel> @3
        asks: list<PriceLevel> @4
        timestamp: TradeTimestamp @5
        sequence: uint64 @6 optional
        is_snapshot: bool @7 optional
    }

    message MarketDataIncrementalRefresh {
        channel_type: stream_item

        symbol: Symbol @1
        updates: list<MarketDataUpdate> @2
        timestamp: TradeTimestamp @3
        sequence: uint64 @4 optional
    }

    message OrderBookRequest {
        channel_type: request_response

        symbol: Symbol @1
        depth: uint32 @2 optional
        at_time: TradeTimestamp @3 optional
    }

    message OrderBookSnapshot {
        channel_type: stream_item

        symbol: Symbol @1
        exchange: string(max_len: 16) @2
        bids: list<PriceLevel> @3
        asks: list<PriceLevel> @4
        timestamp: TradeTimestamp @5
        sequence: uint64 @6 optional
        is_snapshot: bool @7 optional
    }

    message OrderBookDelta {
        channel_type: stream_item

        symbol: Symbol @1
        updates: list<MarketDataUpdate> @2
        timestamp: TradeTimestamp @3
        sequence: uint64 @4 optional
    }

    type AggregateTrade {
        symbol: Symbol
        agg_trade_id: string(max_len: 32)
        price: Price
        qty: Quantity
        side: enum { buy, sell }
        first_trade_id: string(max_len: 32)
        last_trade_id: string(max_len: 32)
        timestamp: TradeTimestamp
    }

    message AggregateTradeEvent {
        channel_type: stream_item

        trade: AggregateTrade @1
    }

    message AggregateTradeRequest {
        channel_type: request_response

        symbol: Symbol @1
        start_time: TradeTimestamp @2 optional
        end_time: TradeTimestamp @3 optional
        limit: uint32 @4 optional
        cursor: string(max_len: 64) @5 optional
    }

    message AggregateTradeBatch {
        channel_type: request_response

        symbol: Symbol @1
        trades: list<AggregateTrade> @2
        has_more: bool @3
        next_cursor: string(max_len: 64) @4 optional
    }

    message MiniTicker {
        channel_type: stream_item

        symbol: Symbol @1
        last_price: Price @2
        volume: Quantity @3
        timestamp: TradeTimestamp @4
        is_snapshot: bool @5 optional
    }

    message AllMidsRequest {
        channel_type: request_response
    }

    message AllMidsBatch {
        channel_type: request_response

        tickers: list<MiniTicker> @1
    }

    message MarkPriceUpdate {
        channel_type: stream_item

        symbol: Symbol @1
        mark_price: Price @2
        index_price: Price @3 optional
        funding_rate: decimal64(precision: 8) @4 optional
        timestamp: TradeTimestamp @5
        is_snapshot: bool @6 optional
    }

    message MarkPriceRequest {
        channel_type: request_response

        symbol: Symbol @1
    }

    type LiquidationTrade {
        symbol: Symbol
        side: enum { buy, sell }
        price: Price
        qty: Quantity
        timestamp: TradeTimestamp
    }

    message LiquidationTradeEvent {
        channel_type: stream_item

        trade: LiquidationTrade @1
    }

    type PriceLevel {
        price: Price
        qty: Quantity
        order_count: uint32 optional
    }

    type MarketDataUpdate {
        side: enum { buy, sell }
        action: enum { new, change, delete }
        price: Price
        qty: Quantity
    }

    type CandleInterval: string(max_len: 8)

    type CandleBar {
        symbol: Symbol
        interval: CandleInterval
        open: Price
        high: Price
        low: Price
        close: Price
        volume: Quantity
        bar_start: TradeTimestamp
        bar_end: TradeTimestamp
        is_final: bool
        is_snapshot: bool optional
    }

    message CandleBarEvent {
        channel_type: stream_item

        bar: CandleBar @1
    }

    message CandleBarRequest {
        channel_type: request_response

        symbol: Symbol @1
        interval: CandleInterval @2
        start_time: TradeTimestamp @3 optional
        end_time: TradeTimestamp @4 optional
        limit: uint32 @5 optional
        cursor: string(max_len: 64) @6 optional
    }

    message CandleBarBatch {
        channel_type: request_response

        symbol: Symbol @1
        interval: CandleInterval @2
        bars: list<CandleBar> @3
        has_more: bool @4
        next_cursor: string(max_len: 64) @5 optional
    }

    type PublicTrade {
        symbol: Symbol
        trade_id: string(max_len: 32)
        price: Price
        qty: Quantity
        side: enum { buy, sell }
        timestamp: TradeTimestamp
    }

    message PublicTradeEvent {
        channel_type: stream_item

        trade: PublicTrade @1
    }

    message TradeHistoryRequest {
        channel_type: request_response

        symbol: Symbol @1
        start_time: TradeTimestamp @2 optional
        end_time: TradeTimestamp @3 optional
        limit: uint32 @4 optional
        cursor: string(max_len: 64) @5 optional
    }

    message PublicTradeBatch {
        channel_type: request_response

        symbol: Symbol @1
        trades: list<PublicTrade> @2
        has_more: bool @3
        next_cursor: string(max_len: 64) @4 optional
    }

    message BestBidOffer {
        channel_type: stream_item

        symbol: Symbol @1
        bid_price: Price @2 optional
        bid_qty: Quantity @3 optional
        ask_price: Price @4 optional
        ask_qty: Quantity @5 optional
        timestamp: TradeTimestamp @6
        is_snapshot: bool @7 optional
    }

    message SymbolTicker {
        channel_type: stream_item

        symbol: Symbol @1
        last_price: Price @2
        price_change: decimal64(precision: 8) @3
        price_change_pct: decimal64(precision: 4) @4
        volume: Quantity @5
        high: Price @6
        low: Price @7
        open: Price @8
        timestamp: TradeTimestamp @9
        is_snapshot: bool @10 optional
    }

    message TickerRequest {
        channel_type: request_response

        symbol: Symbol @1
    }
}
