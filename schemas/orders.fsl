// FIG Schema Language — Trading Orders Schema
// This is the canonical schema for FIG order entry and execution.
// Well-known Schema ID: 0x01

schema trading.orders v1.0.0 {
    description: "Standard order entry and execution messages"
    well_known_id: 0x01

    // --- Custom Types ---

    type ClientOrderId: string(max_len: 20, pattern: "[A-Za-z0-9\\-]+")
    type Price: decimal64(precision: 8, min: 0)
    type Quantity: decimal64(precision: 0, min: 0, max: 999999999)
    type Symbol: string(max_len: 8, uppercase: true)
    type TradeTimestamp: int64  // nanoseconds since Unix epoch

    // --- Messages ---

    message NewOrderSingle {
        channel_type: request_response
        correlation_field: cl_ord_id

        cl_ord_id: ClientOrderId @1
        side: enum { buy, sell, sell_short, sell_short_exempt } @2
        order_qty: Quantity @3
        price: Price @4 optional
        stop_price: Price @11 optional
        symbol: Symbol @5
        order_type: enum { market, limit, stop, stop_limit, market_on_close, limit_on_close, pegged } @6
        time_in_force: enum { day, gtc, ioc, fok, gtd } @7
        expire_time: TradeTimestamp @8 optional
        account: string(max_len: 32) @9 optional
        strategy_id: string(max_len: 64) @10 optional
        security_id: string(max_len: 48) @12 optional
        id_source: enum { cusip, sedol, isin, ric, exchange_symbol } @13 optional
        security_exchange: string(max_len: 16) @14 optional

        priority: high
        idempotent: false
    }

    message CancelRequest {
        channel_type: request_response
        correlation_field: cl_ord_id

        cl_ord_id: ClientOrderId @1
        orig_cl_ord_id: ClientOrderId @2
        symbol: Symbol @3
        side: enum { buy, sell, sell_short } @4
        order_qty: Quantity @5 optional

        priority: high
    }

    message CancelReplaceRequest {
        channel_type: request_response
        correlation_field: cl_ord_id

        cl_ord_id: ClientOrderId @1
        orig_cl_ord_id: ClientOrderId @2
        symbol: Symbol @3
        side: enum { buy, sell, sell_short } @4
        order_qty: Quantity @5
        price: Price @6 optional

        priority: high
    }

    message ExecutionReport {
        channel_type: stream_item
        correlation_field: cl_ord_id

        cl_ord_id: ClientOrderId @1
        order_id: string(max_len: 32) @2
        exec_id: string(max_len: 20) @3
        exec_type: enum {
            new, partial_fill, fill, done_for_day,
            canceled, replaced, pending_cancel, stopped,
            rejected, suspended, pending_new, expired
        } @4
        ord_status: enum {
            new, partially_filled, filled, done_for_day,
            canceled, pending_cancel, stopped, rejected,
            suspended, pending_new, expired, replaced
        } @5
        side: enum { buy, sell, sell_short } @6
        last_qty: Quantity @7 optional
        last_price: Price @8 optional
        leaves_qty: Quantity @9
        cum_qty: Quantity @10
        avg_price: Price @11
        symbol: Symbol @12
        transact_time: TradeTimestamp @13

        priority: high
    }

    message CancelReject {
        channel_type: request_response
        correlation_field: cl_ord_id

        cl_ord_id: ClientOrderId @1
        orig_cl_ord_id: ClientOrderId @2
        reject_reason: enum { order_not_found, already_canceled, already_filled, too_late_to_cancel } @3
        symbol: Symbol @4
    }

    message MarketDataSnapshot {
        channel_type: stream_item

        symbol: Symbol @1
        exchange: string(max_len: 16) @2
        bids: list<PriceLevel> @3
        asks: list<PriceLevel> @4
        timestamp: TradeTimestamp @5
    }

    message MarketDataIncrementalRefresh {
        channel_type: stream_item

        symbol: Symbol @1
        updates: list<MarketDataUpdate> @2
        timestamp: TradeTimestamp @3
    }

    // --- Nested Types ---

    type PriceLevel {
        price: Price
        qty: Quantity
        order_count: uint32 optional
    }

    type MarketDataUpdate {
        side: enum { buy, sell } 
        action: enum { new, change, delete }
        price: Price
        qty: Quantity
    }

    message AccountSummary {
        channel_type: request_response

        account: string(max_len: 32) @1
        balance: decimal64(precision: 2) @2
        buying_power: decimal64(precision: 2) @3
        currency: string(max_len: 3) @4
    }

    // --- §17 Market Data (candles, trades, BBO) ---

    type CandleInterval: string(max_len: 8)

    type CandleBar {
        symbol: Symbol
        interval: CandleInterval
        open: Price
        high: Price
        low: Price
        close: Price
        volume: Quantity
        bar_start: TradeTimestamp
        bar_end: TradeTimestamp
        is_final: bool
        is_snapshot: bool optional
    }

    message CandleBarEvent {
        channel_type: stream_item

        bar: CandleBar @1
    }

    message CandleBarRequest {
        channel_type: request_response

        symbol: Symbol @1
        interval: CandleInterval @2
        start_time: TradeTimestamp @3 optional
        end_time: TradeTimestamp @4 optional
        limit: uint32 @5 optional
    }

    message CandleBarBatch {
        channel_type: request_response

        symbol: Symbol @1
        interval: CandleInterval @2
        bars: list<CandleBar> @3
        has_more: bool @4
        next_cursor: string(max_len: 64) @5 optional
    }

    type PublicTrade {
        symbol: Symbol
        trade_id: string(max_len: 32)
        price: Price
        qty: Quantity
        side: enum { buy, sell }
        timestamp: TradeTimestamp
    }

    message PublicTradeEvent {
        channel_type: stream_item

        trade: PublicTrade @1
    }

    message TradeHistoryRequest {
        channel_type: request_response

        symbol: Symbol @1
        start_time: TradeTimestamp @2 optional
        end_time: TradeTimestamp @3 optional
        limit: uint32 @4 optional
    }

    message PublicTradeBatch {
        channel_type: request_response

        symbol: Symbol @1
        trades: list<PublicTrade> @2
        has_more: bool @3
        next_cursor: string(max_len: 64) @4 optional
    }

    message BestBidOffer {
        channel_type: stream_item

        symbol: Symbol @1
        bid_price: Price @2 optional
        bid_qty: Quantity @3 optional
        ask_price: Price @4 optional
        ask_qty: Quantity @5 optional
        timestamp: TradeTimestamp @6
        is_snapshot: bool @7 optional
    }

    // --- §17 Account / Portfolio ---

    message MarginSummary {
        channel_type: request_response

        account: string(max_len: 32) @1
        balance: decimal64(precision: 2) @2
        buying_power: decimal64(precision: 2) @3
        equity: decimal64(precision: 2) @4
        margin_used: decimal64(precision: 2) @5
        available: decimal64(precision: 2) @6
        currency: string(max_len: 3) @7
    }

    type BalanceEntry {
        asset: string(max_len: 16)
        total: decimal64(precision: 8)
        available: decimal64(precision: 8)
        hold: decimal64(precision: 8)
    }

    message BalanceSnapshot {
        channel_type: stream_item

        account: string(max_len: 32) @1
        balances: list<BalanceEntry> @2
        is_snapshot: bool @3 optional
    }

    message BalanceUpdate {
        channel_type: stream_item

        account: string(max_len: 32) @1
        asset: string(max_len: 16) @2
        delta: decimal64(precision: 8) @3
        total: decimal64(precision: 8) @4
        available: decimal64(precision: 8) @5
        reason: enum { trade, deposit, withdrawal, transfer, fee } @6
    }

    type PositionEntry {
        symbol: Symbol
        qty: Quantity
        entry_price: Price
        unrealized_pnl: decimal64(precision: 2)
    }

    message PositionSnapshot {
        channel_type: stream_item

        account: string(max_len: 32) @1
        positions: list<PositionEntry> @2
        is_snapshot: bool @3 optional
    }

    message PositionUpdate {
        channel_type: stream_item

        account: string(max_len: 32) @1
        symbol: Symbol @2
        qty: Quantity @3
        entry_price: Price @4
        unrealized_pnl: decimal64(precision: 2) @5
    }

    message FillHistoryRequest {
        channel_type: request_response

        account: string(max_len: 32) @1
        symbol: Symbol @2 optional
        start_time: TradeTimestamp @3 optional
        end_time: TradeTimestamp @4 optional
        limit: uint32 @5 optional
    }

    message FillHistoryBatch {
        channel_type: request_response

        account: string(max_len: 32) @1
        fills: list<ExecutionReport> @2
        has_more: bool @3
        next_cursor: string(max_len: 64) @4 optional
    }

    message SymbolTicker {
        channel_type: stream_item

        symbol: Symbol @1
        last_price: Price @2
        price_change: decimal64(precision: 8) @3
        price_change_pct: decimal64(precision: 4) @4
        volume: Quantity @5
        high: Price @6
        low: Price @7
        open: Price @8
        timestamp: TradeTimestamp @9
        is_snapshot: bool @10 optional
    }

    message TickerRequest {
        channel_type: request_response

        symbol: Symbol @1
    }

    message FundingPayment {
        channel_type: stream_item

        account: string(max_len: 32) @1
        symbol: Symbol @2 optional
        amount: decimal64(precision: 8) @3
        rate: decimal64(precision: 8) @4
        timestamp: TradeTimestamp @5
    }

    message FundingHistoryRequest {
        channel_type: request_response

        account: string(max_len: 32) @1
        start_time: TradeTimestamp @2 optional
        end_time: TradeTimestamp @3 optional
        limit: uint32 @4 optional
    }

    message FundingHistoryBatch {
        channel_type: request_response

        account: string(max_len: 32) @1
        payments: list<FundingPayment> @2
        has_more: bool @3
        next_cursor: string(max_len: 64) @4 optional
    }

    message LedgerUpdate {
        channel_type: stream_item

        account: string(max_len: 32) @1
        asset: string(max_len: 16) @2
        delta: decimal64(precision: 8) @3
        kind: enum { deposit, withdrawal, transfer, fee, funding } @4
        timestamp: TradeTimestamp @5
        reference_id: string(max_len: 64) @6 optional
    }

    message LedgerHistoryRequest {
        channel_type: request_response

        account: string(max_len: 32) @1
        start_time: TradeTimestamp @2 optional
        end_time: TradeTimestamp @3 optional
        limit: uint32 @4 optional
    }

    message LedgerHistoryBatch {
        channel_type: request_response

        account: string(max_len: 32) @1
        entries: list<LedgerUpdate> @2
        has_more: bool @3
        next_cursor: string(max_len: 64) @4 optional
    }

    // --- Gateway Mappings (optional, for legacy compatibility) ---

    gateway fix {
        message NewOrderSingle -> MsgType: "D" {
            cl_ord_id -> tag: 11
            side -> tag: 54 values: { buy: "1", sell: "2", sell_short: "5", sell_short_exempt: "6" }
            order_qty -> tag: 38
            price -> tag: 44
            stop_price -> tag: 99
            symbol -> tag: 55
            order_type -> tag: 40 values: {
                market: "1", limit: "2", stop: "3", stop_limit: "4",
                market_on_close: "5", limit_on_close: "B", pegged: "P"
            }
            time_in_force -> tag: 59 values: { day: "0", gtc: "1", ioc: "3", fok: "4", gtd: "6" }
            expire_time -> tag: 432
            account -> tag: 1
            security_id -> tag: 48
            id_source -> tag: 22 values: {
                cusip: "1", sedol: "2", isin: "4", ric: "5", exchange_symbol: "8"
            }
            security_exchange -> tag: 207
        }

        message CancelRequest -> MsgType: "F" {
            cl_ord_id -> tag: 11
            orig_cl_ord_id -> tag: 41
            symbol -> tag: 55
            side -> tag: 54
            order_qty -> tag: 38 optional
        }

        message CancelReplaceRequest -> MsgType: "G" {
            cl_ord_id -> tag: 11
            orig_cl_ord_id -> tag: 41
            symbol -> tag: 55
            side -> tag: 54
            order_qty -> tag: 38
            price -> tag: 44 optional
        }

        message ExecutionReport -> MsgType: "8" {
            cl_ord_id -> tag: 11
            order_id -> tag: 37
            exec_id -> tag: 17
            exec_type -> tag: 150
            ord_status -> tag: 39
            side -> tag: 54
            last_qty -> tag: 32
            last_price -> tag: 31
            leaves_qty -> tag: 151
            cum_qty -> tag: 14
            avg_price -> tag: 6
            symbol -> tag: 55
            transact_time -> tag: 60
        }

        message CancelReject -> MsgType: "9" {
            cl_ord_id -> tag: 11
            orig_cl_ord_id -> tag: 41
            reject_reason -> tag: 102 values: {
                order_not_found: "1",
                already_canceled: "6",
                already_filled: "2",
                too_late_to_cancel: "0"
            }
            symbol -> tag: 55
        }
    }

    gateway rest {
        message NewOrderSingle -> method: POST path: "/accounts/{account}/orders"
        message CancelRequest -> method: DELETE path: "/orders/{orig_cl_ord_id}"
        message CancelReplaceRequest -> method: PUT path: "/orders/{orig_cl_ord_id}"
        message ExecutionReport -> method: SSE path: "/accounts/{account}/executions"
        message AccountSummary -> method: GET path: "/accounts/{account}"
        message MarginSummary -> method: GET path: "/accounts/{account}/margin"
        message MarketDataSnapshot -> method: GET path: "/marketdata/{symbol}"
        message CandleBarRequest -> method: GET path: "/marketdata/{symbol}/candles/{interval}"
        message CandleBarBatch -> method: GET path: "/marketdata/{symbol}/candles/{interval}"
        message TradeHistoryRequest -> method: GET path: "/marketdata/{symbol}/trades"
        message FillHistoryRequest -> method: GET path: "/accounts/{account}/fills"
        message CandleBarEvent -> method: SSE path: "/marketdata/{symbol}/candles/{interval}"
        message PublicTradeEvent -> method: SSE path: "/marketdata/{symbol}/trades"
        message BalanceSnapshot -> method: SSE path: "/accounts/{account}/balances"
        message BalanceUpdate -> method: SSE path: "/accounts/{account}/balances"
        message TickerRequest -> method: GET path: "/marketdata/{symbol}/ticker"
        message SymbolTicker -> method: SSE path: "/marketdata/{symbol}/ticker"
        message FundingHistoryRequest -> method: GET path: "/accounts/{account}/funding"
        message LedgerHistoryRequest -> method: GET path: "/accounts/{account}/ledger"
        message FundingPayment -> method: SSE path: "/accounts/{account}/funding"
        message LedgerUpdate -> method: SSE path: "/accounts/{account}/ledger"
    }

    // gateway ws (declarative; parsed by ws_catalog.rs until FSL codegen supports ws block)
    //   btcusdt@kline_{interval} -> SUBSCRIBE marketdata/{symbol}/candles/{interval}
    //   {symbol}@trade -> SUBSCRIBE marketdata/{symbol}/trades
    //   {symbol}@bookTicker -> SUBSCRIBE marketdata/{symbol}/bbo
    //   hl subscribe trades -> SUBSCRIBE marketdata/{coin}/trades
}
