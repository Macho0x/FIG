FROM rust:1.83-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p fig-core --features observability-bin --bin fig-observability

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/fig-observability /usr/local/bin/
EXPOSE 9090
CMD ["fig-observability", "--listen", "0.0.0.0:9090"]
