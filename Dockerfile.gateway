FROM rust:1.83-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p fig-gateways --bin fig-gateway

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/fig-gateway /usr/local/bin/
EXPOSE 8080 8090 9876 8081 9091
CMD ["fig-gateway"]
